{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bengzhui://rules/card-schema/v1",
  "title": "崩坠牌局卡牌定义",
  "type": "object",
  "required": ["id", "name_key", "name", "category", "profession", "cost", "price", "target", "range", "effects", "tags", "description", "suit", "rank", "color", "durability", "copies", "provisional"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name_key": {"type": "string"},
    "name": {"type": "string"},
    "category": {"enum": ["attack", "skill", "response", "equipment", "奇异"]},
    "profession": {"type": "string"},
    "cost": {"type": "object", "required": ["stamina", "mana"], "properties": {"stamina": {"type": "integer", "minimum": 0}, "mana": {"type": "integer", "minimum": 0}}},
    "price": {"type": "integer", "minimum": 0},
    "target": {"type": "string"},
    "range": {"type": "integer", "minimum": 0},
    "effects": {"type": "array", "items": {"type": "object", "required": ["op"]}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "suit": {"enum": ["none", "hearts", "diamonds", "clubs", "spades"]},
    "rank": {"type": "integer", "minimum": 0, "maximum": 13},
    "color": {"enum": ["none", "red", "black"]},
    "durability": {"type": "integer", "minimum": 0},
    "copies": {"type": "integer", "minimum": 1},
    "provisional": {"type": "boolean"},
    "instance_id": {"type": "string"}
  },
  "additionalProperties": true
}
